[private]
default:
    @just --list

# Run linter
lint:
    golangci-lint run ./...

# Run tests
test:
    go test -v ./...

# Build binary (runs go generate first)
build:
    go generate ./...
    go build -o echo-graphql .

# Run server locally
run:
    go run .

# Format code
fmt:
    go fmt ./...
    goimports -w .

# Clean build artifacts
clean:
    rm -f echo-graphql

# Tidy dependencies
tidy:
    go mod tidy

# Check formatting without changing files
fmt-check:
    @out="$(gofmt -l . && goimports -l .)" || exit 1; if [ -n "$out" ]; then echo "Not formatted (run \`just fmt\`):"; echo "$out"; exit 1; fi

# In CI, fail when build changed the committed generated code or produced
# files that are not committed (locally that is work in progress)
[private]
generated-check:
    @if [ -n "${CI:-}" ] && [ -n "$(git status --porcelain -- graph/generated.go graph/models_gen.go)" ]; then echo "Generated code is out of date; run \`just build\` and commit it:"; git status --short -- graph/generated.go graph/models_gen.go; exit 1; fi

# Everything CI runs for this server
ci: lint fmt-check test build generated-check
